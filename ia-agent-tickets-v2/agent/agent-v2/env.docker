# ── LLM ──────────────────────────────────────────────────────────────────────
# Proveedor activo: anthropic | vercel | groq | ollama
LLM_PROVIDER=vercel

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Vercel AI Gateway ─────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=<YOUR_VERCEL_AI_GATEWAY_KEY>
AI_GATEWAY_MODEL=xiaomi/mimo-v2.5

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Security ───────────────────────────────────────────────────────────────────
SECURITY_CLASSIFIER_ENABLED=false

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_ADAPTER=odoo
BACKEND_URL=http://172.19.0.1:8000  # Express backend (dev only)

# ── Odoo (producción) ─────────────────────────────────────────────────────────
ODOO_BASE_URL=http://172.19.0.1:8069
ODOO_DATABASE=<YOUR_ODOO_DATABASE>
ODOO_USER=<YOUR_ODOO_USER>
ODOO_PASSWORD=<YOUR_ODOO_PASSWORD>

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6
VECTOR_STORE_PATH=/app/vector_store

# ── Checkpointer ──────────────────────────────────────────────────────────────
CHECKPOINT_BACKEND=postgres
POSTGRES_DSN=<YOUR_POSTGRES_DSN>
CHECKPOINT_DB_PATH=/app/data/checkpoints.db

# ── Feedback ──────────────────────────────────────────────────────────────────
FEEDBACK_DB_PATH=/app/data/feedback.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# ⚠ Cambiar en producción — NUNCA usar este valor en deploy real
AGENT_API_KEY=dev-key-change-in-prod

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8002
# Workers: número de procesos uvicorn (Gunicorn). 2-4 recomendado.
# Solo aplica con Dockerfile (producción). Dev usa uvicorn --reload (1 worker).
WORKERS=2

# CORS: solo Odoo y redes internas Docker (NO frontend público)
CORS_ORIGINS=["http://172.17.0.1","http://172.18.0.1","http://172.19.0.1","http://host.docker.internal"]

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<YOUR_LANGSMITH_API_KEY>
LANGSMITH_PROJECT=ia-helpdesk-agent-v2

# ── Ollama (fallback LLM) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://172.19.0.1:11434
OLLAMA_MODEL=qwen3:14b

# ═══════════════════════════════════════════════════════════════════════════════
# SETUP:
#   cp .env.example .env    (o este archivo)
#   Editar .env con tus credenciales reales
#   .env NUNCA se commitea (está en .gitignore)
# ═══════════════════════════════════════════════════════════════════════════════
