# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Backend ───────────────────────────────────────────────────────────────────
# host.docker.internal = el host Windows visto desde dentro del contenedor
BACKEND_ADAPTER=express
BACKEND_URL=http://host.docker.internal:8000

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6
VECTOR_STORE_PATH=/app/vector_store

# ── Checkpointer ──────────────────────────────────────────────────────────────
CHECKPOINT_BACKEND=postgres
POSTGRES_DSN=postgresql://helpdesk_agent:helpdesk2024@host.docker.internal:5432/helpdesk_checkpoints
CHECKPOINT_DB_PATH=/app/data/checkpoints.db

# ── Feedback ──────────────────────────────────────────────────────────────────
FEEDBACK_DB_PATH=/app/data/feedback.db

# ── Auth ──────────────────────────────────────────────────────────────────────
AGENT_API_KEY=dev-key-change-in-prod

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT="ia-helpdesk-agent-v2"

# ── Ollama (fallback LLM) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
